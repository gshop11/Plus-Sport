{
  "name": "plussport-template",
  "version": "1.0.0",
  "description": "Plantilla de tienda deportiva reutilizable con panel admin",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "reset": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "generate:types": "payload generate:types",
    "seed": "npx tsx src/seed.ts",
    "seed:catalogo": "npx tsx src/seed-catalogo.ts",
    "seed:staging-demo": "node scripts/seed-staging-demo-content.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@payloadcms/db-postgres": "^3.85.2",
    "@payloadcms/db-sqlite": "^3.85.2",
    "@payloadcms/next": "^3.85.2",
    "@payloadcms/richtext-lexical": "^3.85.2",
    "@payloadcms/storage-vercel-blob": "^3.85.2",
    "graphql": "^16.13.1",
    "next": "^16.2.10",
    "payload": "^3.85.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
