# =============================================
# PLUSSPORT - VARIABLES DE ENTORNO
# Copia este archivo como .env en desarrollo o .env.production en VPS.
# Nunca uses estos placeholders como credenciales reales.
# =============================================

# Runtime
# En desarrollo puede quedar en development. En VPS debe ser production.
NODE_ENV=development

# URL publica de la tienda.
# En VPS usar https://tudominio.com despues de configurar nginx + SSL.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload CMS
# Requerido. En production debe tener minimo 32 caracteres y no ser placeholder.
PAYLOAD_SECRET=change-this-to-a-random-secret-with-at-least-32-characters

# Base de datos
# Desarrollo: si se omite DATABASE_URI, Payload usa SQLite local en ./dev.db.
# Produccion/VPS: requerido y debe apuntar a PostgreSQL.
# Ejemplo: DATABASE_URI=postgresql://plussport_user:change-this-password@127.0.0.1:5432/plussport
DATABASE_URI=

# Compatibilidad con proveedores que exponen otros nombres de conexion.
# El codigo prioriza: DATABASE_URI, DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING, DATABASE_URL.
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=

# Esquema Payload / Drizzle
# Default recomendado: vacio/false para evitar prompts interactivos de Drizzle.
# Activar true solo de forma manual y temporal para bootstrap/migracion controlada.
PAYLOAD_DB_PUSH=

# Media / uploads
# Default sin token: uploads locales en public/media.
# En VPS esa carpeta debe ser persistente (volumen, symlink o backup).
# Si se configura BLOB_READ_WRITE_TOKEN, Payload usa Vercel Blob para media.
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_MEDIA_BASE_URL=
MEDIA_BASE_URL=

# Servidor Next.js
PORT=3000

# Izipay sandbox
IZIPAY_ENV=sandbox

# URL publica base para construir return/webhook en local o VPS.
# Si no se define, se usa NEXT_PUBLIC_SERVER_URL.
IZIPAY_PUBLIC_BASE_URL=http://localhost:3000

# Endpoint backend auth/session token (sandbox).
# Ejemplo referencial: https://api-pw.izipay.pe/security/v1/Token/Generate
IZIPAY_SESSION_TOKEN_URL=

# Credenciales backend (se envian solo servidor a servidor).
IZIPAY_API_USERNAME=
IZIPAY_API_PASSWORD=

# Compatibilidad con naming anterior.
IZIPAY_USERNAME=
IZIPAY_PASSWORD=

# Llave publica RSA para SDK web checkout (keyRSA/public key).
IZIPAY_KEY_RSA=
IZIPAY_PUBLIC_KEY=

# Clave hash para firma (se usara en fase webhook/validacion).
IZIPAY_HASH_KEY=
IZIPAY_HMAC_KEY=

# Codigo de comercio configurado en panel Izipay.
IZIPAY_MERCHANT_CODE=

# URL del SDK web sandbox.
IZIPAY_CHECKOUT_JS_URL=https://sandbox-checkout.izipay.pe/payments/v1/js/index.js

# Moneda de la transaccion.
IZIPAY_CURRENCY=PEN

# URL retorno frontend post-checkout (callback visual).
# Recomendado: https://tu-dominio/confirmacion
IZIPAY_RETURN_URL=

# URL IPN/webhook futura (fase siguiente, fuente de verdad final).
# Recomendado: https://tu-dominio/api/payments/izipay/webhook
IZIPAY_WEBHOOK_URL=

