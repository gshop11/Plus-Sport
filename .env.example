# =============================================
# PLUSSPORT - VARIABLES DE ENTORNO
# Copia este archivo como .env en desarrollo o .env.production en VPS.
# Nunca uses estos placeholders como credenciales reales.
# =============================================

# Runtime
# En desarrollo puede quedar en development. En VPS debe ser production.
NODE_ENV=development

# URL publica de la tienda.
# En VPS usar https://tudominio.com despues de configurar nginx + SSL.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload CMS
# Requerido. En production debe tener minimo 32 caracteres y no ser placeholder.
PAYLOAD_SECRET=change-this-to-a-random-secret-with-at-least-32-characters

# Base de datos
# Desarrollo: si se omite DATABASE_URI, Payload usa SQLite local en ./dev.db.
# Produccion/VPS: requerido y debe apuntar a PostgreSQL.
# Ejemplo: DATABASE_URI=postgresql://plussport_user:change-this-password@127.0.0.1:5432/plussport
DATABASE_URI=

# Compatibilidad con proveedores que exponen otros nombres de conexion.
# Runtime prioriza: DATABASE_URI, DATABASE_URL, POSTGRES_URL (pooled),
# y como ultimo recurso DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING.
# Migraciones (payload migrate) priorizan: DATABASE_URI_MIGRATIONS,
# POSTGRES_URL_NON_POOLING, DATABASE_URL_UNPOOLED (endpoint directo).
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
DATABASE_URI_MIGRATIONS=

# Pool de PostgreSQL en runtime (por instancia serverless). Default: 5.
PG_POOL_MAX=

# En Vercel, los hosts de Neon se reescriben automaticamente al endpoint
# pooler (-pooler). Poner true solo para desactivar esa reescritura.
PG_DISABLE_POOLER_REWRITE=

# Esquema Payload / Drizzle
# Default recomendado: vacio/false para evitar prompts interactivos de Drizzle.
# Activar true solo de forma manual y temporal para bootstrap/migracion controlada.
PAYLOAD_DB_PUSH=

# Media / uploads
# Default sin token: uploads locales en public/media.
# En VPS esa carpeta debe ser persistente (volumen, symlink o backup).
# Si se configura BLOB_READ_WRITE_TOKEN, Payload usa Vercel Blob para media.
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_MEDIA_BASE_URL=
MEDIA_BASE_URL=

# Servidor Next.js
PORT=3000

# Izipay - Micuentaweb REST V4 / Krypton
# Producto real confirmado en Back Office Vendedor (secure.micuentaweb.pe).
IZIPAY_ENV=sandbox

# FEATURE FLAG del pago con tarjeta. DEBE permanecer en false hasta resolver
# con soporte Izipay el incidente INT_015 ("Invalid input customer.email").
# Con false: la tarjeta no se ofrece en checkout y los endpoints
# /api/payments/izipay/* devuelven respuesta controlada (403/503).
IZIPAY_CARD_ENABLED=false

# URL publica base para construir return/webhook en local o VPS.
# Si no se define, se usa NEXT_PUBLIC_SERVER_URL.
IZIPAY_PUBLIC_BASE_URL=http://localhost:3000

# Servidor API REST Micuentaweb (backend server-to-server, POST .../V4/Charge/CreatePayment).
IZIPAY_API_BASE_URL=https://api.micuentaweb.pe/api-payment

# Credenciales backend (usuario API REST + password test/produccion). Solo servidor a servidor.
IZIPAY_API_USERNAME=
IZIPAY_API_PASSWORD=

# Clave publica test/produccion (no secreta). Se entrega al cliente via respuesta del
# endpoint de sesion, nunca embebida en el bundle build-time. Ver README_IZIPAY.md.
IZIPAY_PUBLIC_KEY=
# Alternativa si el frontend necesitara leerla directamente (no usada por defecto en este repo).
NEXT_PUBLIC_IZIPAY_PUBLIC_KEY=

# Clave HMAC-SHA-256 test/produccion para validar kr-hash del webhook/IPN.
IZIPAY_HMAC_SHA256_KEY=

# SDK web Krypton (formulario embebido kr-payment-form).
IZIPAY_KR_PAYMENT_FORM_JS_URL=https://static.micuentaweb.pe/static/js/krypton-client/V4.0/stable/kr-payment-form.min.js
IZIPAY_KR_CLASSIC_CSS_URL=https://static.micuentaweb.pe/static/js/krypton-client/V4.0/ext/classic.css
IZIPAY_KR_CLASSIC_JS_URL=https://static.micuentaweb.pe/static/js/krypton-client/V4.0/ext/classic.js

# Moneda de la transaccion.
IZIPAY_CURRENCY=PEN

# URL retorno frontend post-checkout (callback visual, no autoritativo).
# Recomendado: https://tu-dominio/confirmacion
IZIPAY_RETURN_URL=

# URL IPN/webhook (fuente de verdad final). Aun no parametrizada en Back Office Vendedor
# a la fecha de esta fase (6B) - queda pendiente configurarla ahi (fase 6C/humana).
# Recomendado: https://tu-dominio/api/payments/izipay/webhook
IZIPAY_WEBHOOK_URL=

